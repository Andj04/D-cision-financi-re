# Donnees : ne jamais pousser sur GitHub (on garde seulement les .gitkeep)
data/**
!data/**/
!data/**/.gitkeep

# Cles et secrets
.env
*.key
secrets.*

# Divers
__pycache__/
.ipynb_checkpoints/
.venv/
.DS_Store

# Exceptions : petits artefacts versionnés (audit, prédictions, tables de scores, paramètres)
!data/processed/*.csv
!data/processed/*.json
!models/
!models/*.joblib
!reports/
!params/

# Rapport : archive pour Overleaf et fichiers de compilation LaTeX
rapport/*.zip
rapport/*.aux
rapport/*.log
rapport/*.out
rapport/*.toc
rapport/*.lof
rapport/*.lot
rapport/*.bbl
rapport/*.blg
rapport/*.pdf
